{
  "name": "feedless",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bun scripts/generate-css.ts",
    "dev": "bun run generate && wxt",
    "dev:firefox": "bun run generate && wxt -b firefox",
    "build": "bun run generate && wxt build",
    "zip": "bun run generate && wxt zip",
    "zip:firefox": "bun run generate && wxt zip -b firefox",
    "zip:safari": "bun run generate && wxt zip -b safari",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "e2e": "playwright test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.10.6",
    "sharp": "^0.35.3",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
